---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

// One list rather than a Featured/Recent split: featured posts sort to the
// top and carry a marker, so the homepage reads as a single index.
const homePosts = [
  ...sortedPosts.filter(({ data }) => data.featured),
  ...sortedPosts.filter(({ data }) => !data.featured),
].slice(0, postsConfig.perIndex);

const hasMorePosts = sortedPosts.length > homePosts.length;
const homePath = getRelativeLocaleUrl(locale, "");
const rssPath = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`;
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-12 pb-10 sm:pt-16">
      <h1
        class="font-text text-3xl leading-[1.15] font-semibold tracking-[-0.02em] text-balance sm:text-4xl"
      >
        Hi, I&apos;m Alexandru <span class="align-baseline">👋</span>
      </h1>
      <div class="mt-6 max-w-[64ch] space-y-4 text-pretty">
        <p>
          I&apos;m a software engineer who enjoys building things, breaking
          them, and occasionally writing about what I learned in the process.
          This blog is where I share short, focused posts on software
          development — from small “How To” guides to lessons learned the hard
          way.
        </p>
      </div>
      <div class="mt-8 flex items-center gap-x-3">
        {socials.length > 0 && <Socials />}
        {
          socials.length > 0 && (
            <span aria-hidden="true" class="bg-border h-4 w-px" />
          )
        }
        <a
          target="_blank"
          href={rssPath}
          class="mono-meta text-muted-foreground hover:text-accent flex items-center gap-x-1.5"
        >
          <IconRss class="size-4 rtl:-rotate-90" aria-hidden="true" />
          RSS
        </a>
      </div>
    </section>

    <section id="writing" class="pt-10 pb-6">
      <h2 class="mono-label text-muted-foreground">{t.home.writing}</h2>
      <ul class="mt-5">
        {homePosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
      {
        hasMorePosts && (
          <div class="border-border border-t pt-6">
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="mono-meta gap-x-1.5"
            >
              {t.home.allPosts}
              <IconArrowRight
                class="size-4 rtl:-rotate-180"
                aria-hidden="true"
              />
            </LinkButton>
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
